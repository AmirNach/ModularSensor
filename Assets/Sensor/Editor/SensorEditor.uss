.sensor-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 12px;
    margin-bottom: 2px;
    margin-left: 3px;
}

.sensor-hint {
    opacity: 0.75;
    white-space: normal;
    margin-left: 3px;
    margin-bottom: 6px;
}

.sensor-window {
    padding: 8px;
}

.sensor-settings-row {
    flex-direction: row;
    align-items: center;
}

.sensor-settings-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.sensor-tree-area {
    margin-top: 6px;
}

.sensor-advanced {
    margin-top: 10px;
}

.sensor-open-window {
    align-self: flex-end;
    margin-top: 4px;
}

/* Refresh rate */

.sensor-refresh-card {
    margin: 4px 0 6px 0;
    padding: 8px 10px;
    border-radius: 5px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--unity-colors-helpbox-border);
    border-left-color: rgb(62, 142, 208);
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-refresh-row {
    flex-direction: row;
    align-items: center;
}

.sensor-refresh-title {
    -unity-font-style: bold;
    font-size: 15px;
    flex-grow: 1;
}

.sensor-refresh-field {
    width: 80px;
}

.sensor-refresh-unit {
    margin-left: 6px;
    opacity: 0.8;
}

.sensor-refresh-summary {
    -unity-font-style: bold;
    margin: 4px 0 0 3px;
}

/* Toolbar and preview */

.sensor-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.sensor-filter {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 60px;
}

.sensor-preview {
    white-space: normal;
    padding: 6px 8px;
    margin: 2px 3px 6px 3px;
    border-radius: 4px;
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
}

/* Cards */

.sensor-card {
    margin: 2px 0 2px 0;
    border-radius: 5px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--unity-colors-helpbox-border);
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-card--and {
    border-left-color: rgb(62, 142, 208);
}

.sensor-card--or {
    border-left-color: rgb(214, 150, 40);
}

.sensor-card--not {
    border-left-color: rgb(205, 84, 84);
}

.sensor-card--leaf {
    border-left-color: rgb(125, 125, 125);
}

.sensor-card--injector {
    border-left-color: rgb(150, 105, 200);
}

.sensor-card--match {
    border-color: rgb(235, 190, 60);
    border-left-color: rgb(235, 190, 60);
}

.sensor-card--dimmed {
    opacity: 0.45;
}

.sensor-card-header {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 1px 2px 1px 0;
}

.sensor-card-body {
    padding: 2px 6px 6px 8px;
}

.sensor-children {
    margin: 0 4px 4px 12px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-helpbox-border);
}

.sensor-handle {
    width: 16px;
    -unity-text-align: middle-center;
    font-size: 15px;
    opacity: 0.6;
}

.sensor-handle:hover {
    opacity: 1;
}

.sensor-arrow {
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    font-size: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.sensor-badge {
    -unity-font-style: bold;
    font-size: 10px;
    padding: 1px 5px;
    margin-right: 5px;
    border-radius: 3px;
    color: rgb(255, 255, 255);
    background-color: rgb(110, 110, 110);
}

.sensor-card--and > .sensor-card-header > .sensor-badge {
    background-color: rgb(40, 110, 170);
}

.sensor-card--or > .sensor-card-header > .sensor-badge {
    background-color: rgb(160, 105, 15);
}

.sensor-card--not > .sensor-card-header > .sensor-badge {
    background-color: rgb(170, 55, 55);
}

.sensor-card--injector > .sensor-card-header > .sensor-badge {
    background-color: rgb(115, 75, 165);
}

.sensor-card-title {
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-right: 8px;
}

.sensor-header-spacer {
    flex-grow: 1;
}

.sensor-card-summary {
    opacity: 0.75;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.sensor-warning {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 4px;
}

.sensor-warning-icon {
    width: 14px;
    height: 14px;
    margin-right: 2px;
}

.sensor-warning-text {
    color: rgb(214, 150, 40);
}

.sensor-menu-button {
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0 5px;
}

.sensor-add-button {
    align-self: flex-start;
    margin: 3px 0 2px 0;
}

.sensor-empty {
    padding: 8px;
    white-space: normal;
}

.sensor-empty > Label {
    white-space: normal;
    margin-bottom: 6px;
}

.sensor-missing {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 6px;
    margin: 2px 0;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(205, 84, 84);
}

.sensor-drop-line {
    position: absolute;
    height: 2px;
    background-color: rgb(62, 142, 208);
}

/* Live view */

.sensor-live-targets {
    margin-bottom: 4px;
}

.sensor-live-target {
    -unity-text-align: middle-left;
    margin: 1px 0;
}

.sensor-live-target--selected {
    border-width: 2px;
    border-color: rgb(62, 142, 208);
    -unity-font-style: bold;
}

.sensor-live-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 6px;
    margin: 1px 0;
    border-radius: 4px;
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-status {
    -unity-font-style: bold;
}

.sensor-status--passed {
    color: rgb(70, 170, 90);
}

.sensor-status--failed {
    color: rgb(215, 90, 90);
}

.sensor-status--skipped {
    opacity: 0.6;
    -unity-font-style: normal;
}
