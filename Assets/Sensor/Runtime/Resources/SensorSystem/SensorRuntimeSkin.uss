/* The overlay has no Editor theme, so this supplies the colors the shared sheet expects and re-colors
   Unity's light runtime controls for a dark panel. Everything is scoped to .sensor-overlay. */

.sensor-overlay {
    --unity-colors-helpbox-background: rgb(58, 58, 58);
    --unity-colors-helpbox-border: rgb(30, 30, 30);
    color: rgb(226, 226, 226);
    font-size: 13px;
}

.sensor-overlay Label,
.sensor-overlay .unity-label,
.sensor-overlay .unity-base-field__label,
.sensor-overlay .unity-foldout__text,
.sensor-overlay .unity-toggle__text,
.sensor-overlay .unity-base-popup-field__text,
.sensor-overlay .unity-text-element {
    color: rgb(226, 226, 226);
}

.sensor-overlay .unity-button {
    background-color: rgb(84, 84, 84);
    border-color: rgb(30, 30, 30);
    color: rgb(236, 236, 236);
    border-radius: 4px;
}

.sensor-overlay .unity-button:hover {
    background-color: rgb(106, 106, 106);
}

.sensor-overlay .unity-button:active {
    background-color: rgb(66, 66, 66);
}

.sensor-overlay .unity-button:disabled {
    opacity: 0.5;
}

/* The fold arrow is a button in code, but it should look like a bare arrow. These come after the
   button rules above so they win. */
.sensor-overlay .sensor-arrow {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(222, 222, 222);
}

.sensor-overlay .sensor-arrow:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.sensor-overlay .sensor-arrow:active {
    background-color: rgba(255, 255, 255, 0.22);
}

/* Value boxes: darker than the card, with a clear edge, so a number or slider stands out */
.sensor-overlay .unity-base-text-field__input,
.sensor-overlay .unity-base-field__input,
.sensor-overlay .unity-base-popup-field__input,
.sensor-overlay .unity-integer-field__input,
.sensor-overlay .unity-float-field__input {
    background-color: rgb(22, 22, 22);
    border-color: rgb(96, 96, 96);
    border-radius: 3px;
    color: rgb(246, 246, 246);
}

.sensor-overlay .unity-base-text-field__input:focus,
.sensor-overlay .unity-base-field__input:focus {
    border-color: rgb(62, 142, 208);
}

.sensor-overlay .unity-toggle__checkmark {
    background-color: rgb(30, 30, 30);
    border-color: rgb(18, 18, 18);
    -unity-background-image-tint-color: rgb(232, 232, 232);
}

.sensor-overlay .unity-toggle__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.sensor-overlay .unity-base-slider__tracker {
    background-color: rgb(140, 140, 140);
    border-color: rgb(80, 80, 80);
}

.sensor-overlay .unity-base-slider__dragger {
    background-color: rgb(232, 232, 232);
    border-color: rgb(60, 60, 60);
}

.sensor-overlay .unity-scroller,
.sensor-overlay .unity-scroller__slider,
.sensor-overlay .unity-scroller__low-button,
.sensor-overlay .unity-scroller__high-button {
    background-color: rgb(44, 44, 44);
    border-color: rgb(30, 30, 30);
}

.sensor-overlay .unity-scroller__slider .unity-base-slider__dragger {
    background-color: rgb(110, 110, 110);
}

.sensor-overlay .unity-list-view__item {
    color: rgb(226, 226, 226);
}

.sensor-overlay .unity-collection-view__item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.sensor-overlay .unity-collection-view__item--selected,
.sensor-overlay .unity-collection-view__item:selected {
    background-color: rgb(44, 93, 135);
}

.sensor-overlay .unity-list-view__scroll-view,
.sensor-overlay .unity-list-view {
    border-color: rgb(30, 30, 30);
}

/* The button that opens the panel, and the panel */

.sensor-overlay-toggle {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 6px 14px;
    background-color: rgb(30, 30, 30);
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    border-radius: 5px;
    -unity-font-style: bold;
}

.sensor-overlay-toggle--open {
    background-color: rgb(44, 93, 135);
}

.sensor-overlay-panel {
    position: absolute;
    top: 46px;
    right: 8px;
    bottom: 8px;
    width: 720px;
    padding: 8px 10px;
    background-color: rgb(38, 38, 38);
    border-width: 1px;
    border-color: rgb(18, 18, 18);
    border-radius: 6px;
}

.sensor-overlay-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.sensor-overlay-title {
    -unity-font-style: bold;
    font-size: 16px;
}

.sensor-overlay-close {
    width: 26px;
    padding: 0;
}

.sensor-overlay-source {
    margin-bottom: 4px;
}

.sensor-overlay-content {
    flex-grow: 1;
    flex-shrink: 1;
}
