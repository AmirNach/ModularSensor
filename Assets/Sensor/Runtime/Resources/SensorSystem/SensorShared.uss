.sensor-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 12px;
    margin-bottom: 2px;
    margin-left: 3px;
}

.sensor-hint {
    opacity: 0.75;
    white-space: normal;
    margin-left: 3px;
    margin-bottom: 6px;
}

.sensor-window {
    padding: 8px;
}

.sensor-settings-row {
    flex-direction: row;
    align-items: center;
}

.sensor-settings-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.sensor-tree-area {
    margin-top: 6px;
}

.sensor-advanced {
    margin-top: 10px;
}

.sensor-open-window {
    align-self: flex-end;
    margin-top: 4px;
}

/* Refresh rate */

.sensor-refresh-card {
    margin: 4px 0 6px 0;
    padding: 8px 10px;
    border-radius: 5px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--unity-colors-helpbox-border);
    border-left-color: rgb(62, 142, 208);
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-refresh-row {
    flex-direction: row;
    align-items: center;
}

.sensor-refresh-title {
    -unity-font-style: bold;
    font-size: 15px;
    flex-grow: 1;
}

.sensor-refresh-field {
    width: 80px;
}

.sensor-refresh-unit {
    margin-left: 6px;
    opacity: 0.8;
}

.sensor-refresh-summary {
    -unity-font-style: bold;
    margin: 4px 0 0 3px;
}

/* Toolbar and preview */

.sensor-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.sensor-filter {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 60px;
}

.sensor-preview {
    white-space: normal;
    padding: 6px 8px;
    margin: 2px 3px 6px 3px;
    border-radius: 4px;
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
}

/* Cards */

.sensor-card {
    margin: 2px 0 2px 0;
    border-radius: 5px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--unity-colors-helpbox-border);
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-card--and {
    border-left-color: rgb(62, 142, 208);
}

.sensor-card--or {
    border-left-color: rgb(214, 150, 40);
}

.sensor-card--not {
    border-left-color: rgb(205, 84, 84);
}

.sensor-card--leaf {
    border-left-color: rgb(125, 125, 125);
}

.sensor-card--injector {
    border-left-color: rgb(150, 105, 200);
}

.sensor-card--match {
    border-color: rgb(235, 190, 60);
    border-left-color: rgb(235, 190, 60);
}

.sensor-card--dimmed {
    opacity: 0.45;
}

.sensor-card-header {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 1px 2px 1px 0;
}

.sensor-card-body {
    /* The left padding leaves room for the small arrows Unity draws for lists, so they do not touch the bar. */
    padding: 2px 6px 6px 18px;
}

.sensor-children {
    margin: 0 4px 4px 12px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-helpbox-border);
}

.sensor-handle {
    width: 16px;
    -unity-text-align: middle-center;
    font-size: 15px;
    opacity: 0.6;
}

.sensor-handle:hover {
    opacity: 1;
}

/* One glyph, turned sideways when closed, so the arrow never changes size */
.sensor-arrow {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    margin: 0 6px 0 2px;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 3px;
    rotate: 0deg;
}

.sensor-arrow--collapsed {
    rotate: -90deg;
}

.sensor-arrow:hover {
    background-color: rgba(255, 255, 255, 0.12);
}

.sensor-badge {
    -unity-font-style: bold;
    font-size: 10px;
    padding: 1px 5px;
    margin-right: 5px;
    border-radius: 3px;
    color: rgb(255, 255, 255);
    background-color: rgb(110, 110, 110);
}

.sensor-card--and > .sensor-card-header > .sensor-badge {
    background-color: rgb(40, 110, 170);
}

.sensor-card--or > .sensor-card-header > .sensor-badge {
    background-color: rgb(160, 105, 15);
}

.sensor-card--not > .sensor-card-header > .sensor-badge {
    background-color: rgb(170, 55, 55);
}

.sensor-card--injector > .sensor-card-header > .sensor-badge {
    background-color: rgb(115, 75, 165);
}

.sensor-card-title {
    -unity-font-style: bold;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sensor-header-spacer {
    flex-grow: 1;
}

.sensor-card-summary {
    opacity: 0.75;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.sensor-warning {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 4px;
}

.sensor-warning-icon {
    width: 14px;
    height: 14px;
    margin-right: 2px;
}

.sensor-warning-text {
    color: rgb(214, 150, 40);
}

.sensor-menu-button {
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0 5px;
}

.sensor-add-button {
    align-self: flex-start;
    margin: 3px 0 2px 0;
}

.sensor-empty {
    padding: 8px;
    white-space: normal;
}

.sensor-empty > Label {
    white-space: normal;
    margin-bottom: 6px;
}

.sensor-missing {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 6px;
    margin: 2px 0;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(205, 84, 84);
}

.sensor-drop-line {
    position: absolute;
    height: 2px;
    background-color: rgb(62, 142, 208);
}

/* Live view */

.sensor-target-list {
    margin-bottom: 4px;
}

.sensor-target-group {
    margin: 2px 0;
    padding-left: 4px;
    border-left-width: 3px;
    border-left-color: rgb(125, 125, 125);
}

.sensor-target-group--passed {
    border-left-color: rgb(70, 170, 90);
}

.sensor-target-group--failed {
    border-left-color: rgb(215, 90, 90);
}

.sensor-target-group--injected {
    border-left-color: rgb(150, 105, 200);
}

/* An empty group says "None" inside. It is not faded, so it reads like the others. */
.sensor-target-group--empty {
    opacity: 1;
}

.sensor-target-items {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 2px 4px 4px 0;
}

.sensor-target-row {
    flex-direction: row;
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px;
}

.sensor-target-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 40px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.sensor-target-detail {
    flex-shrink: 0;
    width: 60px;
    margin: 0 0 0 8px;
    padding: 0;
    opacity: 0.7;
    -unity-text-align: middle-right;
}

/* The detection ID, like #28 */
.sensor-target-id {
    flex-shrink: 0;
    width: 34px;
    margin: 0 0 0 8px;
    padding: 0;
    opacity: 0.7;
    -unity-text-align: middle-right;
}

/* Room for a full GUID. Shorter identifiers, like xxxx:xxxx:xxxx:xxxx, leave spare space. */
.sensor-target-identifier {
    flex-shrink: 0;
    width: 275px;
    margin: 0 0 0 8px;
    padding: 0;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

/* Which sensors detect it, in the detector view. It shortens before anything else but the name. */
.sensor-target-extra {
    flex-shrink: 0;
    width: 80px;
    margin: 0 0 0 8px;
    padding: 0;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

.sensor-section {
    margin-top: 6px;
}

/* The collapsible group: one arrow, the same everywhere */

.sensor-group-header {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding-left: 4px;
}

.sensor-group-title {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.sensor-group-content {
    margin-left: 26px;
}

.sensor-section > .sensor-group-header .sensor-group-title {
    -unity-font-style: bold;
    font-size: 14px;
}

.sensor-params .sensor-group-content {
    margin-left: 22px;
}

.sensor-detector-summary {
    -unity-font-style: bold;
    white-space: normal;
    margin: 2px 3px 6px 3px;
}

.sensor-live-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 3px 6px;
    margin: 1px 0;
    border-radius: 4px;
    background-color: var(--unity-colors-helpbox-background);
}

.sensor-status {
    -unity-font-style: bold;
}

.sensor-status--passed {
    color: rgb(70, 170, 90);
}

.sensor-status--failed {
    color: rgb(215, 90, 90);
}

.sensor-status--skipped {
    opacity: 0.6;
    -unity-font-style: normal;
}

/* Search box that works in the Editor and in builds */

.sensor-search {
    flex-direction: row;
    align-items: center;
}

.sensor-search-input {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 1px 2px;
}

.sensor-search-clear {
    width: 22px;
    margin: 1px 2px 1px 0;
    padding: 0;
}

/* Editable values of a condition */

.sensor-params {
    padding: 2px 0;
}

.sensor-param-header {
    -unity-font-style: bold;
    margin: 6px 0 2px 3px;
}

.sensor-param-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
    padding: 2px 3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.05);
}

.sensor-param-row-control {
    flex-grow: 1;
    flex-shrink: 1;
}

.sensor-param-remove {
    width: 22px;
    margin-left: 4px;
    padding: 0;
    flex-shrink: 0;
}

.sensor-param-list {
    margin-left: 4px;
}

.sensor-param-readonly {
    opacity: 0.7;
    margin: 2px 3px;
    white-space: normal;
}

.sensor-reset-button {
    align-self: flex-start;
    margin: 6px 3px;
}

/* Column titles above the rows of a group. They use the row's column classes, so they line up. */
.sensor-target-header {
    flex-direction: row;
    align-items: center;
    padding: 0 7px 0 7px;
    margin: 2px 4px 0 0;
}

.sensor-target-header > Label {
    -unity-font-style: bold;
    font-size: 11px;
    opacity: 0.6;
}

.sensor-target-header > .sensor-target-name {
    -unity-text-align: middle-left;
}

.sensor-target-header > .sensor-target-detail,
.sensor-target-header > .sensor-target-id,
.sensor-target-header > .sensor-target-extra {
    -unity-text-align: middle-right;
}

.sensor-visual-toggle {
    margin: 0 8px 0 4px;
    flex-shrink: 0;
}
